# ==============================
# Notion BE - Environment Sample
# ==============================

# Runtime
NODE_ENV=development

# App config
DEV_APP_HOST=localhost
DEV_APP_PORT=4000
DEV_APP_NAME=notion-clone

PRO_APP_HOST=0.0.0.0
PRO_APP_PORT=4000
PRO_APP_NAME=notion-clone

# Database config (PostgreSQL)
DEV_DB_USER=dev
DEV_DB_PASSWORD=devpassword
DEV_DB_HOST=localhost
DEV_DB_PORT=5431
DEV_DB_NAME=notion_db

PRO_DB_USER=produser
PRO_DB_PASSWORD=change_me
PRO_DB_HOST=prod-db-host
PRO_DB_PORT=5432
PRO_DB_NAME=notion_db

# Prisma connection URL (development)
DATABASE_URL=postgresql://dev:devpassword@localhost:5431/notion_db?schema=public&api_key=your_dev_api_key

# Redis config
# If using the provided docker-compose, host port is 6378.
DEV_REDIS_HOST=localhost
DEV_REDIS_PORT=6378
DEV_REDIS_PASSWORD=
DEV_REDIS_DB=0

PRO_REDIS_HOST=prod-redis-host
PRO_REDIS_PORT=6379
PRO_REDIS_PASSWORD=
PRO_REDIS_DB=0

# Logger config
DEV_LOGGER_LEVEL=debug
DEV_LOGGER_FILE=logs/combined.log
DEV_LOGGER_ERROR_FILE=logs/error.log
DEV_LOGGER_MAX_SIZE=10m
DEV_LOGGER_MAX_FILES=14d

PRO_LOGGER_LEVEL=info
PRO_LOGGER_FILE=logs/combined.log
PRO_LOGGER_ERROR_FILE=logs/error.log
PRO_LOGGER_MAX_SIZE=10m
PRO_LOGGER_MAX_FILES=14d

# JWT config
DEV_JWT_SECRET=replace_with_secure_dev_secret
DEV_JWT_EXPIRES_IN=1d

PRO_JWT_SECRET=replace_with_secure_prod_secret
PRO_JWT_EXPIRES_IN=7d

# API key config
DEV_API_KEY=your_dev_api_key
PRO_API_KEY=replace_with_secure_prod_api_key

# Frontend URL for CORS
CLIENT_URL=http://localhost:4400

# Password reset / email
RESET_PASSWORD_TOKEN_EXPIRY=3600
EMAIL_USER=example@gmail.com
EMAIL_PASS=replace_with_app_password
